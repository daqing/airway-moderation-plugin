# --- Moderation ---

# Shared secret callers present as the X-Moderation-Secret header on /screen,
# /words and /reload. Unset leaves those endpoints open, which is only meant
# for a local checkout; set it wherever more than one person can reach the
# host, and give the calling service the same value.
# MODERATION_SECRET=""

# Word list the service screens against. Relative paths resolve against the
# working directory the host runs in. A path that is not there falls back to
# the word list built into the plugin, and the health endpoint says so.
MODERATION_WORDS_FILE="config/moderation_words.json"
